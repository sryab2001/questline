{
  "expo": {
    "name": "Questline",
    "slug": "questline",
    "version": "0.8.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "questline",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050912",
    "android": {
      "package": "com.questline.app",
      "adaptiveIcon": {
        "backgroundColor": "#050912",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050912",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#5cd0ff"
        }
      ],
      "expo-secure-store",
      "expo-audio",
      "expo-asset",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/rajdhani/700Bold/Rajdhani_700Bold.ttf",
            "./node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf"
          ],
          "widgets": [
            {
              "name": "DailyQuest",
              "label": "Daily Quest",
              "description": "Today's quests. Tap a circle to clear one.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/images/widget-preview.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "69056a4b-fcde-41e9-a9cc-abb87325e9eb"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/69056a4b-fcde-41e9-a9cc-abb87325e9eb"
    }
  }
}
